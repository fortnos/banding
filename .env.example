# =============================
# Aplikasi
# =============================
APP_NAME=Gmail Banding
APP_TIMEZONE=Asia/Jakarta

# =============================
# Admin login (wajib diganti!)
# =============================
ADMIN_USER=admin
ADMIN_PASS=ganti-password-kuat

# =============================
# Database (MySQL / MariaDB)
# =============================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=banding
DB_USER=banding
DB_PASS=banding-pass

# =============================
# Fitur banding
# =============================
# Halaman appeal resmi Google (akun yang dinonaktifkan
# akan menampilkan tombol "Start Appeal" setelah login)
GOOGLE_APPEAL_URL=https://accounts.google.com/Login

# Domain email yang diizinkan (pisahkan dengan koma, kosongkan = semua domain)
ALLOWED_DOMAINS=gmail.com,googlemail.com

# Jeda antar pembukaan tab (milidetik) & batas tab per sesi
BANDING_DELAY_MS=3000
MAX_TABS=10
